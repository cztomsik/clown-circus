{
  "include": ["src/**/*", "webui/**/*"],
  "exclude": ["webui/vendor"],
  "compilerOptions": {
    "strict": false,
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
